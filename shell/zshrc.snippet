# --- 42-dev-bootstrap ------------------------------------------------
# Paste these lines into ~/.zshrc (loaded by interactive zsh shells — regular
# terminals). MISE env vars are duplicated here because ~/.profile isn't
# sourced by non-login shells.

export MISE_DATA_DIR="/sgoinfre/goinfre/Perso/${USER}/mise-data"
export MISE_CACHE_DIR="/goinfre/${USER}/mise-cache"
# Rust toolchains + cargo registry on sgoinfre. The cluster sets
# RUSTUP_HOME/CARGO_HOME to root-owned /opt/rust in /etc/zsh/zshenv; mise's
# rust backend needs writable homes, and `mise activate` re-exports
# RUSTUP_HOME/CARGO_HOME from these so cargo/rustup see the same dirs.
export MISE_RUSTUP_HOME="/sgoinfre/goinfre/Perso/${USER}/rustup"
export MISE_CARGO_HOME="/sgoinfre/goinfre/Perso/${USER}/cargo"
eval "$(mise activate zsh)"

# Start Tailscale userspace daemon (SOCKS5 on 127.0.0.1:1055).
# Backgrounded (&!) — on cold start the launcher polls up to 10s for the
# daemon, which would otherwise block the prompt.
[[ -x "$HOME/bin/tailscale-serve" ]] && "$HOME/bin/tailscale-serve" &>/dev/null &!

# Minimal prompt with git branch (requires zsh's vcs_info). Optional.
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats ' %F{magenta}(%b)%f'
setopt PROMPT_SUBST
PROMPT='%F{blue}%~%f${vcs_info_msg_0_} %F{green}❯%f '
# --- end 42-dev-bootstrap --------------------------------------------
