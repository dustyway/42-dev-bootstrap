#!/usr/bin/env bash
# 42-dev-uninstall — list & uninstall components installed by 42-dev-bootstrap.
#
# Two removal modes:
#   uninstall     remove files AND comment out the matching `*-bootstrap`
#                 line(s) in shell init, so next login does NOT bring it back
#   cleanup mode  remove files only — components whose init line is intact
#                 will be re-downloaded on next login
#
# Usage:
#   42-dev-uninstall                            fzf TUI (default). In the picker:
#                                                 ↑/↓           move
#                                                 type          filter
#                                                 Enter         ask cleanup/uninstall/abort
#                                                               for the highlighted row,
#                                                               then act and refresh
#                                                 Esc           quit
#   42-dev-uninstall --list                     text table instead of TUI (no removal)
#   42-dev-uninstall <name> [-y]                non-interactive: files only
#   42-dev-uninstall <name> --uninstall [-y]    non-interactive: files + init lines
#   42-dev-uninstall --all-safe [-y]            bulk: every "safe" component, files only
#   42-dev-uninstall --all-safe --uninstall     bulk uninstall
#
# Requires fzf for the TUI — run `fzf-bootstrap` once if it's missing.
#
# Components are classified "safe" (the matching bootstrap will reinstall on
# next login) or "DATA" (user data, no bootstrap restores it).
#
# The "Login" column in the listing shows whether next login will reinstall
# the component automatically — detected by grepping ~/.zprofile, ~/.profile,
# ~/.zshrc, ~/.bashrc, ~/.bash_profile for the matching `<x>-bootstrap` call.
#
# Shim detection is dynamic: walks ~/bin, ~/.local/bin, and desktop entries,
# resolves symlinks and greps wrapper scripts for paths under the doomed dir,
# and chains transitively (a script that references a doomed shim is doomed).

set -euo pipefail

SGO="$(ls -d /sgoinfre/goinfre/Perso/*"${USER}"* 2>/dev/null | head -n1)"
[[ -z "$SGO" ]] && { echo "[42-dev-uninstall] sgoinfre path not found for $USER" >&2; exit 1; }

INIT_FILES=("$HOME/.zprofile" "$HOME/.profile" "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile")

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPONENTS_LIB="$SCRIPT_DIR/../lib/components.bash"
[[ -f "$COMPONENTS_LIB" ]] || COMPONENTS_LIB="$HOME/Apps/lib/components.bash"
[[ -f "$COMPONENTS_LIB" ]] || { echo "[42-dev-uninstall] components registry not found" >&2; exit 1; }
source "$COMPONENTS_LIB"

# name | path globs (colon-separated) | class | restore_pattern (ERE) | note
# restore_pattern = "" means nothing in shell init restores it.
UNINSTALL_COMPONENTS=()

cleanup_globs_for() {
    case "$1" in
        emacs)          printf '%s' "$SGO/emacs:$SGO/.cache/emacs-*.tar.gz:$SGO/.cache/emacs-*.tar.gz.sha256" ;;
        clangd)         printf '%s' "$SGO/clangd:$SGO/.cache/clangd-linux-*.zip" ;;
        wx)             printf '%s' "$SGO/wx:$SGO/.cache/wx-*.tar.gz:$SGO/.cache/wx-*.tar.gz.sha256" ;;
        tailscale)      printf '%s' "$SGO/tailscale:$SGO/.cache/tailscale_*.tgz" ;;
        gh)             printf '%s' "$SGO/gh:$SGO/.cache/gh_*.tar.gz:$SGO/.cache/gh_*_checksums.txt" ;;
        postgres)       printf '%s' "$SGO/postgres:$SGO/.cache/postgresql-*.tar.gz:$SGO/.cache/postgresql-*.tar.gz.sha256" ;;
        act)            printf '%s' "$SGO/act:$SGO/.cache/act_*.tar.gz:$SGO/.cache/act_*_checksums.txt" ;;
        actionlint)     printf '%s' "$SGO/actionlint:$SGO/.cache/actionlint_*.tar.gz:$SGO/.cache/actionlint_*_checksums.txt" ;;
        graphviz)       printf '%s' "$SGO/graphviz:$SGO/.cache/graphviz-*" ;;
        inotify-tools)  printf '%s' "$SGO/inotify-tools:$SGO/.cache/inotify-tools-*.tar.gz:$SGO/.cache/inotify-tools-*.tar.gz.sha256" ;;
        aider)          printf '%s' "$SGO/uv-tools/aider-chat:$HOME/.local/share/uv/tools/aider-chat:$HOME/.local/bin/aider" ;;
        opencode)       printf '%s' "$SGO/mise-data/installs/github-anomalyco-opencode:$SGO/mise-data/shims/opencode" ;;
        jetbrains/*)    printf '%s:%s/.cache/jb-%s.tar.gz' "$SGO/$1" "$SGO" "${1#jetbrains/}" ;;
        *)              printf '%s' "$SGO/$1" ;;
    esac
}

build_components() {
    UNINSTALL_COMPONENTS=()
    local row globs
    for row in "${COMPONENTS[@]}"; do
        parse_component_row "${row%%|*}" || continue
        [[ "$C_CLASS" == "safe" ]] || continue
        globs=$(cleanup_globs_for "$C_NAME")
        UNINSTALL_COMPONENTS+=("${C_NAME}|${globs}|${C_CLASS}|${C_PATTERN}|${C_DESC}")
    done

    UNINSTALL_COMPONENTS+=(
        "jetbrains-config|$SGO/jetbrains-config|DATA||IDE settings/plugins/keymaps. Curated backup at ~/Apps/etc/jetbrains-backup restores most of it."
        "forum-pgdata|$SGO/forum-pgdata|DATA||PostgreSQL data directory. No bootstrap restores this."
        "forum-build|$SGO/forum-build|DATA||Build artifacts. No bootstrap restores this."
        "CLion_cache|$SGO/CLion_cache|DATA||CLion cache. Re-indexed on next launch (slow but automatic)."
    )
}
build_components

# Parse a row by name. The restore_pattern may contain `|` (alternation), so
# split the fixed left fields first and then split note/pattern from the right.
parse_row() {
    local needle="$1" row
    for row in "${UNINSTALL_COMPONENTS[@]}"; do
        C_NAME=${row%%|*}
        [[ "$C_NAME" != "$needle" ]] && continue
        # Strip leading "name|"
        local rest=${row#*|}
        C_GLOBS=${rest%%|*}; rest=${rest#*|}
        C_CLASS=${rest%%|*}; rest=${rest#*|}
        # Last field is the note; everything before it (back to here) is the pattern.
        C_NOTE=${rest##*|}
        C_PATTERN=${rest%|*}
        return 0
    done
    return 1
}

# ─── helpers ─────────────────────────────────────────────────────────────────

# Single-line progress bar to stderr. No-op when stderr isn't a tty (so the
# noise doesn't end up in pipes / preview captures).
#   progress <cur> <total> <label>
#   progress_done                  clears the line
progress() {
    [[ -t 2 ]] || return 0
    local cur="$1" total="$2" label="$3"
    local width=20 filled empty bar
    filled=$(( cur * width / total ))
    empty=$(( width - filled ))
    bar=$(printf '%*s' "$filled" '' | tr ' ' '#')
    bar+=$(printf '%*s' "$empty"  '' | tr ' ' '.')
    printf "\r\033[K[%s] %2d/%d  %s" "$bar" "$cur" "$total" "$label" >&2
}
progress_done() { [[ -t 2 ]] && printf "\r\033[K" >&2 || true; }

expand_globs() {
    local IFS=':' glob
    read -ra globs <<<"$1"
    for glob in "${globs[@]}"; do
        # shellcheck disable=SC2206
        local matches=( $glob )
        for m in "${matches[@]}"; do
            [[ -e "$m" ]] && printf '%s\n' "$m"
        done
    done
}

human_size() {
    local path="$1"
    [[ -e "$path" ]] || { echo "-"; return; }
    du -sh "$path" 2>/dev/null | awk '{print $1}'
}

total_bytes() {
    local sum=0 bytes
    while IFS= read -r p; do
        [[ -e "$p" ]] || continue
        bytes=$(du -sb "$p" 2>/dev/null | awk '{print $1}')
        sum=$((sum + bytes))
    done
    echo "$sum"
}

format_bytes() {
    local b="$1"
    if   (( b >= 1024**3 )); then awk -v b="$b" 'BEGIN{printf "%.1fG", b/1024/1024/1024}'
    elif (( b >= 1024**2 )); then awk -v b="$b" 'BEGIN{printf "%.0fM", b/1024/1024}'
    elif (( b >= 1024   )); then awk -v b="$b" 'BEGIN{printf "%.0fK", b/1024}'
    else echo "${b}B"
    fi
}

# Transitive shim detection: any symlink resolving inside a doomed path, or
# any regular file whose body grep-matches a doomed path. Newly found shims
# get added to the doomed set so files referencing them are pulled in next.
detect_shims() {
    local doomed=("$@")
    local desktop_dir="$HOME/.local/share/applications"
    local found=() candidates=() d entry

    for d in "$HOME/bin" "$HOME/.local/bin"; do
        [[ -d "$d" ]] || continue
        for entry in "$d"/*; do [[ -e "$entry" ]] && candidates+=("$entry"); done
    done
    if [[ -d "$desktop_dir" ]]; then
        for entry in "$desktop_dir"/*.desktop; do [[ -f "$entry" ]] && candidates+=("$entry"); done
    fi

    local progressed=1 c resolved hit p
    while (( progressed )); do
        progressed=0
        local remaining=()
        for c in "${candidates[@]}"; do
            hit=0
            if [[ -L "$c" ]]; then
                resolved="$(readlink -f -- "$c" 2>/dev/null || true)"
                for p in "${doomed[@]}"; do
                    [[ "$resolved" == "$p" || "$resolved" == "$p"/* ]] && { hit=1; break; }
                done
            elif [[ -f "$c" ]]; then
                for p in "${doomed[@]}"; do
                    grep -qF -- "$p" "$c" 2>/dev/null && { hit=1; break; }
                done
            fi
            if (( hit )); then
                found+=("$c"); doomed+=("$c"); progressed=1
            else
                remaining+=("$c")
            fi
        done
        candidates=("${remaining[@]}")
    done

    (( ${#found[@]} > 0 )) && printf '%s\n' "${found[@]}"
}

# Find non-commented lines in shell init files matching `<pattern>` (ERE).
# Emits one record per line: "file<TAB>line_no<TAB>text".
find_init_lines() {
    local pattern="$1" file line_no text
    [[ -z "$pattern" ]] && return 0
    for file in "${INIT_FILES[@]}"; do
        [[ -f "$file" ]] || continue
        while IFS=: read -r line_no text; do
            [[ -z "$line_no" ]] && continue
            # Skip lines whose first non-blank char is '#'.
            [[ "$text" =~ ^[[:space:]]*# ]] && continue
            printf '%s\t%s\t%s\n' "$file" "$line_no" "$text"
        done < <(grep -nE -- "$pattern" "$file" 2>/dev/null || true)
    done
}

# Comment out the given lines (records from find_init_lines). Idempotent:
# already-commented lines are skipped by find_init_lines, so a second run
# is a no-op. The comment prefix uses today's date for auditability.
comment_out_init_lines() {
    local records=("$@")
    [[ ${#records[@]} -eq 0 ]] && return 0

    local today; today=$(date +%Y-%m-%d)
    local prefix="# [42-dev-uninstall ${today}] "

    # Group by file → list of line numbers, descending so each edit doesn't
    # shift subsequent line numbers within the same file.
    declare -A by_file
    local rec file line text
    for rec in "${records[@]}"; do
        IFS=$'\t' read -r file line text <<<"$rec"
        by_file["$file"]+="$line "
    done

    for file in "${!by_file[@]}"; do
        # Sort line numbers descending so sed -i in-place doesn't disturb
        # later (lower) indices.
        local sorted; sorted=$(echo "${by_file[$file]}" | tr ' ' '\n' | sort -rn | tr '\n' ' ')
        for line in $sorted; do
            # Prepend prefix to that specific line.
            sed -i "${line}s|^|${prefix}|" "$file"
        done
        echo "[42-dev-uninstall] commented out $(echo "${by_file[$file]}" | wc -w) line(s) in $file"
    done
}

# ─── actions ─────────────────────────────────────────────────────────────────

# Compute a short Login indicator for a component: number of matching init
# lines, or "-" if none.
login_status() {
    local pattern="$1" n
    [[ -z "$pattern" ]] && { echo "-"; return; }
    n=$(find_init_lines "$pattern" | wc -l)
    if (( n > 0 )); then echo "yes($n)"; else echo "-"; fi
}

list_all() {
    local row name globs class pattern note paths size_str
    local total_safe=0 total_data=0 bytes
    local total=${#UNINSTALL_COMPONENTS[@]} idx=0
    # Build all the rows first (with progress), then print the table — keeps
    # the table itself unbroken by progress redraws.
    local out=()
    for row in "${UNINSTALL_COMPONENTS[@]}"; do
        idx=$((idx + 1))
        parse_row "${row%%|*}"
        name=$C_NAME; globs=$C_GLOBS; class=$C_CLASS; pattern=$C_PATTERN; note=$C_NOTE
        progress "$idx" "$total" "sizing $name"
        mapfile -t paths < <(expand_globs "$globs")
        (( ${#paths[@]} == 0 )) && continue
        bytes=$(printf '%s\n' "${paths[@]}" | total_bytes)
        size_str=$(format_bytes "$bytes")
        out+=("$(printf "%-24s %8s  %-5s  %-7s  %s" "$name" "$size_str" "$class" "$(login_status "$pattern")" "$note")")
        if [[ "$class" == "safe" ]]; then total_safe=$((total_safe + bytes))
        else total_data=$((total_data + bytes)); fi
    done
    progress_done
    printf "%-24s %8s  %-5s  %-7s  %s\n" "Component" "Size" "Class" "Login" "Notes"
    printf "%-24s %8s  %-5s  %-7s  %s\n" "---------" "----" "-----" "-----" "-----"
    printf '%s\n' "${out[@]}"
    echo
    printf "Reclaimable (safe): %s\n" "$(format_bytes "$total_safe")"
    printf "Reclaimable (DATA): %s\n" "$(format_bytes "$total_data")"
    local used; used=$(du -sb "$SGO" 2>/dev/null | awk '{print $1}')
    printf "sgoinfre usage:     %s of 30G quota\n" "$(format_bytes "$used")"
    echo
    echo "  42-dev-uninstall <name>              remove files (auto-reinstalls if Login=yes)"
    echo "  42-dev-uninstall <name> --uninstall  remove files AND comment out init line(s)"
    echo "  42-dev-uninstall <name> -y           skip confirm"
    echo "  42-dev-uninstall --all-safe          remove every 'safe' component"
}

# Args: name, assume_yes (0|1), uninstall (0|1)
remove_one() {
    local name="$1" yes="$2" uninstall="$3"
    if ! parse_row "$name"; then
        echo "[42-dev-uninstall] unknown component: $name" >&2
        echo "          run '42-dev-uninstall' for the list" >&2
        return 1
    fi
    mapfile -t paths < <(expand_globs "$C_GLOBS")
    if (( ${#paths[@]} == 0 )); then
        echo "[42-dev-uninstall] nothing to remove for '$name' (already gone)"
        # Still offer init-line cleanup if asked.
        if (( uninstall )) && [[ -n "$C_PATTERN" ]]; then
            mapfile -t init_recs < <(find_init_lines "$C_PATTERN")
            (( ${#init_recs[@]} > 0 )) && comment_out_init_lines "${init_recs[@]}"
            post_uninstall_component "$name"
        fi
        return 0
    fi
    mapfile -t shims < <(detect_shims "${paths[@]}")
    mapfile -t init_recs < <(find_init_lines "$C_PATTERN")

    echo "Component: $name  ($C_CLASS)"
    echo "Note: $C_NOTE"
    echo
    echo "Will remove:"
    local p s rec
    for p in "${paths[@]}"; do
        printf "  %-60s  %s\n" "$p" "$(human_size "$p")"
    done
    if (( ${#shims[@]} > 0 )); then
        echo
        echo "Shims / desktop entries:"
        for s in "${shims[@]}"; do printf "  %s\n" "$s"; done
    fi

    if (( ${#init_recs[@]} > 0 )); then
        echo
        if (( uninstall )); then
            echo "Init lines to comment out (--uninstall):"
        else
            echo "Init lines (next login will reinstall — pass --uninstall to also comment these out):"
        fi
        for rec in "${init_recs[@]}"; do
            IFS=$'\t' read -r f l t <<<"$rec"
            printf "  %s:%s  %s\n" "$f" "$l" "$t"
        done
    fi

    local bytes; bytes=$(printf '%s\n' "${paths[@]}" | total_bytes)
    echo
    echo "Total reclaim: $(format_bytes "$bytes")"

    if [[ "$C_CLASS" == "DATA" ]]; then
        echo
        echo "  ⚠  Classified DATA — no bootstrap will restore it."
    fi

    if (( ! yes )); then
        echo
        read -r -p "Proceed? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "[42-dev-uninstall] aborted"; return 1; }
    fi

    for p in "${paths[@]}"; do rm -rf -- "$p"; done
    for s in "${shims[@]}"; do rm -f  -- "$s"; done
    echo "[42-dev-uninstall] removed $name ($(format_bytes "$bytes") freed)"

    if (( uninstall )) && (( ${#init_recs[@]} > 0 )); then
        comment_out_init_lines "${init_recs[@]}"
    fi
    (( uninstall )) && post_uninstall_component "$name"
}

remove_all_safe() {
    local yes="$1" uninstall="$2"
    local doomed=()
    for row in "${UNINSTALL_COMPONENTS[@]}"; do
        parse_row "${row%%|*}"
        [[ "$C_CLASS" == "safe" ]] || continue
        mapfile -t paths < <(expand_globs "$C_GLOBS")
        (( ${#paths[@]} > 0 )) && doomed+=("$C_NAME")
    done
    if (( ${#doomed[@]} == 0 )); then
        echo "[42-dev-uninstall] nothing to remove"
        return 0
    fi
    echo "Will remove every 'safe' component:"
    printf '  %s\n' "${doomed[@]}"
    if (( uninstall )); then
        echo
        echo "(--uninstall: also commenting out matching init lines)"
    fi
    if (( ! yes )); then
        echo
        read -r -p "Proceed? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "[42-dev-uninstall] aborted"; return 1; }
    fi
    for name in "${doomed[@]}"; do
        remove_one "$name" 1 "$uninstall"
    done
}

post_uninstall_component() {
    local name="$1"
    case "$name" in
        opencode)
            if command -v mise >/dev/null 2>&1; then
                MISE_DATA_DIR="$SGO/mise-data" MISE_CACHE_DIR="/goinfre/${USER}/mise-cache" \
                    mise use -g --remove github:anomalyco/opencode >/dev/null 2>&1 \
                    && echo "[42-dev-uninstall] removed OpenCode from global mise config" \
                    || echo "[42-dev-uninstall] warning: failed to remove OpenCode from global mise config" >&2
            else
                echo "[42-dev-uninstall] warning: mise not on PATH; OpenCode may remain in ~/.config/mise/config.toml" >&2
            fi
            ;;
    esac
}

# Dry-run "what would be removed" for one component. Used by fzf --preview.
preview_one() {
    local name="$1"
    if ! parse_row "$name"; then echo "unknown component: $name"; return; fi
    mapfile -t paths < <(expand_globs "$C_GLOBS")
    if (( ${#paths[@]} == 0 )); then echo "(already gone)"; return; fi
    mapfile -t shims < <(detect_shims "${paths[@]}")
    mapfile -t init_recs < <(find_init_lines "$C_PATTERN")

    printf "Component: %s  (%s)\n" "$C_NAME" "$C_CLASS"
    printf "Note: %s\n\n" "$C_NOTE"
    echo "Will remove:"
    local p s rec
    for p in "${paths[@]}"; do
        printf "  %-45s  %s\n" "$p" "$(human_size "$p")"
    done
    if (( ${#shims[@]} > 0 )); then
        echo; echo "Shims / desktop entries:"
        for s in "${shims[@]}"; do printf "  %s\n" "$s"; done
    fi
    if (( ${#init_recs[@]} > 0 )); then
        echo; echo "Init lines (next login will re-run these):"
        for rec in "${init_recs[@]}"; do
            IFS=$'\t' read -r f l t <<<"$rec"
            printf "  %s:%s\n    %s\n" "$f" "$l" "$t"
        done
    fi
    local bytes; bytes=$(printf '%s\n' "${paths[@]}" | total_bytes)
    echo; echo "Total reclaim: $(format_bytes "$bytes")"
}

# Emit one row per existing component, formatted as space-padded columns.
# Arg: 1 = show progress on stderr, 0 = silent (used by fzf's reload binding,
# which re-fetches after every action and shouldn't redraw the bar).
tui_rows() {
    local show_progress="${1:-0}"
    local row paths bytes size_str login
    local total=${#UNINSTALL_COMPONENTS[@]} idx=0
    for row in "${UNINSTALL_COMPONENTS[@]}"; do
        idx=$((idx + 1))
        parse_row "${row%%|*}"
        (( show_progress )) && progress "$idx" "$total" "sizing $C_NAME"
        mapfile -t paths < <(expand_globs "$C_GLOBS")
        (( ${#paths[@]} == 0 )) && continue
        bytes=$(printf '%s\n' "${paths[@]}" | total_bytes)
        size_str=$(format_bytes "$bytes")
        login=$(login_status "$C_PATTERN")
        printf '%-24s %7s  %-4s  %-8s  %s\n' "$C_NAME" "$size_str" "$C_CLASS" "$login" "$C_NOTE"
    done
    (( show_progress )) && progress_done
}

# Per-item interactive action — invoked from fzf via `42-dev-uninstall --apply <name>`.
# Shows the dry-run preview, asks cleanup/uninstall/skip, runs the chosen
# action, pauses so the user sees the output, then returns control to fzf.
apply_interactive() {
    local name="$1"
    if ! parse_row "$name"; then
        echo "[42-dev-uninstall] unknown component: $name" >&2
        sleep 1; return 1
    fi
    local self; self="$(realpath "$0")"

    # Nested fzf — keeps the user in TUI mode; selecting a row IS the
    # confirmation (deliberate move + Enter, not a single keypress).
    local choice
    choice=$(printf '%s\n' \
        "cleanup   — remove files only (will reinstall on next login if Login=yes)" \
        "uninstall — remove files AND comment out matching init line(s)" \
        "abort     — do nothing, return to the picker" \
      | fzf --prompt="Action for '${C_NAME}' > " \
            --preview "$self --preview-of '$name'" \
            --preview-window=right:55%:wrap \
            --layout=reverse \
            --no-info \
            --no-multi \
            --height=100%) || true

    local uninstall_flag=0
    case "${choice%% *}" in
        cleanup)   uninstall_flag=0 ;;
        uninstall) uninstall_flag=1 ;;
        *)         return 0 ;;  # abort or Esc
    esac

    # Silent on success (fzf reload will show the row gone). On failure,
    # show the captured output and pause so the user can read the error.
    local output status
    output=$(remove_one "$name" 1 "$uninstall_flag" 2>&1)
    status=$?
    if (( status != 0 )); then
        clear
        printf '%s\n' "$output"
        echo
        read -r -p "[press Enter to return to the picker] " _
    fi
}

# fzf single-select picker. Pressing Enter on a row hands off to
# `42-dev-uninstall --apply <name>`, which asks cleanup/uninstall/skip and acts.
# fzf then reloads the row list (via `42-dev-uninstall --tui-rows`) so removed
# items disappear. Esc quits.
tui_mode() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[42-dev-uninstall] fzf not found on PATH" >&2
        echo "          install it with: fzf-bootstrap" >&2
        exit 1
    fi
    local self; self="$(realpath "$0")"

    # Pre-build the initial list with progress visible. fzf reads it from
    # stdin; later reloads re-call `--tui-rows` themselves (without progress).
    local initial; initial=$(tui_rows 1)
    [[ -z "$initial" ]] && { echo "[42-dev-uninstall] nothing to clean up"; return 0; }

    local header="Enter  = act on highlighted row (asks: Cleanup / Uninstall / Skip)
Esc    = quit  •  ↑/↓ move  •  type to filter"

    printf '%s\n' "$initial" | \
        fzf --header="$header" \
            --preview "$self --preview-of {1}" \
            --preview-window=right:55%:wrap \
            --bind "enter:execute($self --apply {1})+reload($self --tui-rows)" \
            --layout=reverse \
            --height=100% || true
}

# ─── arg parsing ─────────────────────────────────────────────────────────────

yes=0
uninstall=0
target=""
preview_name=""
apply_name=""
expecting_value=""
for arg in "$@"; do
    if [[ -n "$expecting_value" ]]; then
        case "$expecting_value" in
            preview-of) preview_name="$arg" ;;
            apply)      apply_name="$arg" ;;
        esac
        expecting_value=""
        continue
    fi
    case "$arg" in
        -y|--yes)        yes=1 ;;
        --uninstall)     uninstall=1 ;;
        --list)          target="--list" ;;
        --tui-rows)      target="--tui-rows" ;;
        --preview-of)    expecting_value="preview-of" ;;
        --apply)         expecting_value="apply" ;;
        -h|--help)       sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --all-safe)      target="--all-safe" ;;
        --*)             echo "[42-dev-uninstall] unknown flag: $arg" >&2; exit 2 ;;
        *)               target="$arg" ;;
    esac
done

if [[ -n "$preview_name" ]]; then
    preview_one "$preview_name"
elif [[ -n "$apply_name" ]]; then
    apply_interactive "$apply_name"
elif [[ "$target" == "--tui-rows" ]]; then
    tui_rows 0
elif [[ "$target" == "--list" ]]; then
    list_all
elif [[ "$target" == "--all-safe" ]]; then
    remove_all_safe "$yes" "$uninstall"
elif [[ -z "$target" ]]; then
    tui_mode
else
    remove_one "$target" "$yes" "$uninstall"
fi
