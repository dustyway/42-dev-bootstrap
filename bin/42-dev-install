#!/usr/bin/env bash
# 42-dev-install — fzf TUI for installing components on the 42 cluster.
# Counterpart to `42-dev-uninstall`; same picker layout, same key model.
#
# Usage:
#   42-dev-install                      fzf TUI (default). In the picker:
#                                         ↑/↓           move
#                                         type          filter
#                                         Enter         ask for the highlighted row:
#                                                         Install
#                                                         Install + autostart on login
#                                                         Abort
#                                         Esc           quit
#   42-dev-install --list               text table instead of TUI
#   42-dev-install --install-of <name>  (internal) run install action for one
#                                       component, invoked by fzf's --bind
#   42-dev-install --rows               (internal) emit row data for fzf reload
#   42-dev-install --preview-of <name>  (internal) preview pane content
#
# Requires fzf for the TUI — run `fzf-bootstrap` once if it's missing.

set -euo pipefail

SGO="$(ls -d /sgoinfre/goinfre/Perso/*"${USER}"* 2>/dev/null | head -n1)"
[[ -z "$SGO" ]] && { echo "[42-dev-install] sgoinfre path not found for $USER" >&2; exit 1; }

INIT_FILES=("$HOME/.zprofile" "$HOME/.profile" "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile")

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPONENTS_LIB="$SCRIPT_DIR/../lib/components.bash"
[[ -f "$COMPONENTS_LIB" ]] || COMPONENTS_LIB="$HOME/Apps/lib/components.bash"
[[ -f "$COMPONENTS_LIB" ]] || { echo "[42-dev-install] components registry not found" >&2; exit 1; }
source "$COMPONENTS_LIB"

parse_row() { parse_component_row "$@"; }

# ─── helpers ─────────────────────────────────────────────────────────────────

format_bytes() {
    local b="$1"
    if   (( b >= 1024**3 )); then awk -v b="$b" 'BEGIN{printf "%.1fG", b/1024/1024/1024}'
    elif (( b >= 1024**2 )); then awk -v b="$b" 'BEGIN{printf "%.0fM", b/1024/1024}'
    elif (( b >= 1024   )); then awk -v b="$b" 'BEGIN{printf "%.0fK", b/1024}'
    else echo "${b}B"
    fi
}

installed_size() {
    local path="$SGO/$1"
    [[ -e "$path" ]] || { echo "-"; return; }
    du -sh "$path" 2>/dev/null | awk '{print $1}'
}

is_installed() {
    [[ -e "$SGO/$1" ]]
}

# Count non-commented init-file lines matching the ERE pattern.
init_match_count() {
    local pattern="$1" file count=0
    [[ -z "$pattern" ]] && { echo 0; return; }
    for file in "${INIT_FILES[@]}"; do
        [[ -f "$file" ]] || continue
        while IFS=: read -r line_no text; do
            [[ -z "$line_no" ]] && continue
            [[ "$text" =~ ^[[:space:]]*# ]] && continue
            count=$((count + 1))
        done < <(grep -nE -- "$pattern" "$file" 2>/dev/null || true)
    done
    echo "$count"
}

# Build the autostart line we'd add to ~/.zprofile for a given bootstrap_cmd.
# Format matches the existing entries (subshell + nohup, detached).
autostart_line_for() {
    local cmd="$1"
    printf '(nohup ~/Apps/bin/%s &>/dev/null &)' "$cmd"
}

# Append the autostart line to ~/.zprofile if not already present (anywhere
# in any init file). Returns 0 if appended, 1 if a matching active line is
# already there.
add_autostart() {
    local pattern="$1" cmd="$2"
    local count; count=$(init_match_count "$pattern")
    if (( count > 0 )); then return 1; fi
    local line; line=$(autostart_line_for "$cmd")
    # Ensure the file ends with a newline before appending.
    if [[ -s "$HOME/.zprofile" ]] && [[ "$(tail -c1 "$HOME/.zprofile" | od -An -c | tr -d ' ')" != '\n' ]]; then
        printf '\n' >> "$HOME/.zprofile"
    fi
    printf '%s\n' "$line" >> "$HOME/.zprofile"
    return 0
}

# ─── actions ─────────────────────────────────────────────────────────────────

list_all() {
    local row name cmd path pattern desc
    printf "%-30s %-12s  %-7s  %s\n" "Component" "Installed" "Login" "Notes"
    printf "%-30s %-12s  %-7s  %s\n" "---------" "---------" "-----" "-----"
    for row in "${COMPONENTS[@]}"; do
        parse_row "${row%%|*}"
        name=$C_NAME; cmd=$C_CMD; path=$C_PATH; pattern=$C_PATTERN; desc=$C_DESC
        local size; size=$(installed_size "$path")
        local installed_col; if is_installed "$path"; then installed_col="yes ($size)"; else installed_col="no"; fi
        local n; n=$(init_match_count "$pattern")
        local login_col; if (( n > 0 )); then login_col="yes($n)"; else login_col="-"; fi
        printf "%-30s %-12s  %-7s  %s\n" "$name" "$installed_col" "$login_col" "$desc"
    done
}

# Emit rows for fzf consumption (no header, no separator).
setup_rows() {
    local row
    for row in "${COMPONENTS[@]}"; do
        parse_row "${row%%|*}"
        local size; size=$(installed_size "$C_PATH")
        local installed_col; if is_installed "$C_PATH"; then installed_col="yes ($size)"; else installed_col="no"; fi
        local n; n=$(init_match_count "$C_PATTERN")
        local login_col; if (( n > 0 )); then login_col="yes($n)"; else login_col="-"; fi
        printf '%-30s %-12s  %-8s  %s\n' "$C_NAME" "$installed_col" "$login_col" "$C_DESC"
    done
}

# fzf preview pane for one component.
preview_one() {
    local name="$1"
    if ! parse_row "$name"; then echo "unknown component: $name"; return; fi
    printf "Component:    %s\n" "$C_NAME"
    printf "Bootstrap:    %s\n" "$C_CMD"
    printf "Description:  %s\n\n" "$C_DESC"

    if is_installed "$C_PATH"; then
        printf "Installed:    YES  (size: %s, at %s)\n" "$(installed_size "$C_PATH")" "$SGO/$C_PATH"
    else
        printf "Installed:    NO\n"
    fi

    local n; n=$(init_match_count "$C_PATTERN")
    if (( n > 0 )); then
        printf "Autostart:    YES  (%d line(s) in shell init)\n\n" "$n"
        local file line_no text
        for file in "${INIT_FILES[@]}"; do
            [[ -f "$file" ]] || continue
            while IFS=: read -r line_no text; do
                [[ -z "$line_no" ]] && continue
                [[ "$text" =~ ^[[:space:]]*# ]] && continue
                printf "  %s:%s\n    %s\n" "$file" "$line_no" "$text"
            done < <(grep -nE -- "$C_PATTERN" "$file" 2>/dev/null || true)
        done
    else
        printf "Autostart:    NO  (next login will NOT install this)\n"
        echo
        printf "Install + autostart would append to ~/.zprofile:\n"
        printf "  %s\n" "$(autostart_line_for "$C_CMD")"
    fi
}

# Per-item interactive action — invoked by fzf via `42-dev-install --install-of <name>`.
install_interactive() {
    local name="$1"
    if ! parse_row "$name"; then
        echo "[42-dev-install] unknown component: $name" >&2
        sleep 1; return 1
    fi
    local self; self="$(realpath "$0")"

    # Nested fzf — picking a row is the action confirmation.
    local choice
    choice=$(printf '%s\n' \
        "install            — run \`${C_CMD}\` once (no shell init changes)" \
        "install+autostart  — install AND add a launch line to ~/.zprofile" \
        "abort              — do nothing, return to the picker" \
      | fzf --prompt="Action for '${C_NAME}' > " \
            --preview "$self --preview-of '$name'" \
            --preview-window=right:55%:wrap \
            --layout=reverse \
            --no-info \
            --no-multi \
            --height=100%) || true

    local with_autostart=0
    case "${choice%% *}" in
        install)            ;;
        install+autostart)  with_autostart=1 ;;
        *)                  return 0 ;;  # abort or Esc
    esac

    # The bootstrap streams progress (downloads/extracts) — let it print
    # live; pause only on failure so the user can read the tail.
    clear
    echo "[42-dev-install] running: $C_CMD"
    echo
    if ! eval "$HOME/Apps/bin/$C_CMD"; then
        echo
        echo "[42-dev-install] bootstrap failed — leaving shell init alone" >&2
        read -r -p "[press Enter to return to the picker] " _
        return 1
    fi
    if (( with_autostart )); then
        add_autostart "$C_PATTERN" "$C_CMD" || true
    fi
}

tui_mode() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "[42-dev-install] fzf not found on PATH" >&2
        echo "        install it with: fzf-bootstrap" >&2
        exit 1
    fi
    local self; self="$(realpath "$0")"

    local header="Enter  = act on highlighted row (asks: Install / Install+autostart / Abort)
Esc    = quit  •  ↑/↓ move  •  type to filter"

    setup_rows | \
        fzf --header="$header" \
            --preview "$self --preview-of {1}" \
            --preview-window=right:55%:wrap \
            --bind "enter:execute($self --install-of {1})+reload($self --rows)" \
            --layout=reverse \
            --height=100% || true
}

# ─── arg parsing ─────────────────────────────────────────────────────────────

target=""
preview_name=""
install_name=""
expecting_value=""
for arg in "$@"; do
    if [[ -n "$expecting_value" ]]; then
        case "$expecting_value" in
            preview-of) preview_name="$arg" ;;
            install-of) install_name="$arg" ;;
        esac
        expecting_value=""; continue
    fi
    case "$arg" in
        --list)         target="--list" ;;
        --rows)         target="--rows" ;;
        --preview-of)   expecting_value="preview-of" ;;
        --install-of)   expecting_value="install-of" ;;
        -h|--help)      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --*)            echo "[42-dev-install] unknown flag: $arg" >&2; exit 2 ;;
        *)              echo "[42-dev-install] unknown arg: $arg" >&2; exit 2 ;;
    esac
done

if [[ -n "$preview_name" ]]; then
    preview_one "$preview_name"
elif [[ -n "$install_name" ]]; then
    install_interactive "$install_name"
elif [[ "$target" == "--list" ]]; then
    list_all
elif [[ "$target" == "--rows" ]]; then
    setup_rows
elif [[ -z "$target" ]]; then
    tui_mode
fi
