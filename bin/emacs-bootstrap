#!/usr/bin/env bash
# emacs-bootstrap — install/heal a modern Emacs (tree-sitter + native-comp,
# GTK3/X11) on 42 cluster machines. Safe to run every login (idempotent).
#
# Pulls a tarball built by .github/workflows/build-emacs.yml and published as
# a release of this repo, with a .sha256 file next to it that is required and
# checked. The build provenance is auditable via the workflow file.
#
# Usage:  emacs-bootstrap [VERSION]
# Env override:  EMACS_BOOTSTRAP_REPO=owner/repo (defaults to dustyway/42-dev-bootstrap)
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary      → $SGO/emacs/<version>/           persistent on sgoinfre
# Cached tarball  → $SGO/.cache/emacs-<version>…    ~100 MB, re-extract on wipe
# Launchers       → ~/bin/emacs, ~/bin/emacsclient  symlinks, tiny
# Desktop entry   → ~/.local/share/applications/emacs.desktop
# User config     → $HOME/.emacs.d  (not managed here)
#
# Native-comp .eln cache defaults to ~/.emacs.d/eln-cache and can grow past
# the 5 GB $HOME quota on heavy package users. Redirect it in your init:
#   (when (boundp 'native-comp-eln-load-path)
#     (startup-redirect-eln-cache "/goinfre/$USER/emacs-eln-cache"))
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
# shellcheck source=../lib/bootstrap.bash
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-30.2}"
REPO="${EMACS_BOOTSTRAP_REPO:-dustyway/42-dev-bootstrap}"
ASSET="emacs-${VERSION}-linux-x86_64.tar.gz"
URL="https://github.com/${REPO}/releases/download/emacs-${VERSION}/${ASSET}"
APP_HOME="$SGO/emacs/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/emacs; then
    fetch "$URL" "$CACHE/$ASSET"
    fetch "$URL.sha256" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" --strip-components=1
fi

link_launcher "$APP_HOME/bin/emacs"
link_launcher "$APP_HOME/bin/emacsclient"

# The .desktop file inside the tarball uses Exec=emacs and Icon=emacs, which
# depend on PATH and the icon theme; write one with absolute paths instead.
write_desktop_entry emacs <<DESK
[Desktop Entry]
Name=Emacs
GenericName=Text Editor
Comment=Edit text
MimeType=text/english;text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;
Exec=$HOME/bin/emacs %F
Icon=$APP_HOME/share/icons/hicolor/scalable/apps/emacs.svg
Type=Application
Terminal=false
Categories=Development;TextEditor;
StartupNotify=true
StartupWMClass=Emacs
DESK
