#!/usr/bin/env bash
# wx-bootstrap — install wxWidgets (built by CI) to sgoinfre so Erlang can be
# compiled with wx/observer support on machines without root access.
# Safe to run every login (idempotent: no-op when the version is already in place).
#
# Called by mise-bootstrap before `mise install` to set up
# KERL_CONFIGURE_OPTIONS. Prints the install path to stdout on success; all
# other output goes to stderr.
#
# Pulls a tarball built by CI and published as a release of this repo, with
# a .sha256 file next to it that is required and checked.
#
# Usage:  wx-bootstrap [VERSION]
# Env override:  WX_BOOTSTRAP_REPO=owner/repo (defaults to dustyway/42-dev-bootstrap)
#
# ─── Placement ───────────────────────────────────────────────────────────────
# Install        → $SGO/wx/<version>/                 persistent on sgoinfre
# Cached tarball → $SGO/.cache/wx-<version>-linux-x86_64.tar.gz
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# stdout is reserved for the install path: everything else, including log
# lines and any tool output, goes to stderr; fd 3 keeps the real stdout.
exec 3>&1 1>&2

source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-3.2.6}"
REPO="${WX_BOOTSTRAP_REPO:-dustyway/42-dev-bootstrap}"
ASSET="wx-${VERSION}-linux-x86_64.tar.gz"
URL="https://github.com/${REPO}/releases/download/wx-${VERSION}/${ASSET}"
APP_HOME="$SGO/wx/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/wx-config; then
    fetch "$URL" "$CACHE/$ASSET"
    fetch "$URL.sha256" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"

    install_begin "$APP_HOME" "$VERSION"
    tar -xzf "$CACHE/$ASSET" -C "$APP_HOME.tmp" --strip-components=1

    # wx-config and the pkg-config .pc files embed the CI build prefix
    # /opt/wx; point them at the final install path, so kerl gets the right
    # include and lib paths. This happens before the swap, so a failure here
    # never leaves an unpatched tree marked as installed.
    # wx-config is normally in bin/ but may land elsewhere depending on the
    # build; make sure bin/wx-config resolves either way.
    wx_cfg=$(find "$APP_HOME.tmp" -name wx-config -not -type d | head -n1)
    if [[ -z "$wx_cfg" ]]; then
        find "$APP_HOME.tmp" -maxdepth 4 | head -40 >&2 || true
        rm -rf "$APP_HOME.tmp"
        die "wx-config not found after extraction (tree above)"
    fi
    sed -i "s|/opt/wx|${APP_HOME}|g" "$wx_cfg"
    mkdir -p "$APP_HOME.tmp/bin"
    if [[ "$wx_cfg" != "$APP_HOME.tmp/bin/wx-config" ]]; then
        # Relative to the final tree, not the staging directory.
        ln -sf "${APP_HOME}${wx_cfg#"$APP_HOME.tmp"}" "$APP_HOME.tmp/bin/wx-config"
    fi
    for pc in "$APP_HOME.tmp"/lib/pkgconfig/*.pc; do
        [[ -f "$pc" ]] && sed -i "s|/opt/wx|${APP_HOME}|g" "$pc"
    done
    install_commit "$APP_HOME" "$VERSION"
fi

echo "$APP_HOME" >&3
