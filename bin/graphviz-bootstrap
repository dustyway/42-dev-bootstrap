#!/usr/bin/env bash
# graphviz-bootstrap — install graphviz (`dot`, `neato`, …) without sudo.
#
# 42 cluster users have no sudo, mise has no graphviz plugin, and a source
# build pulls in cairo/pango/libpng/freetype. But `apt-get download` works
# without root: the .debs are extracted with `dpkg-deb -x` into a private
# prefix, and wrappers in ~/bin set LD_LIBRARY_PATH and GVBINDIR so the
# binaries find their libraries and plugins there. The plugins dlopen cairo,
# pango etc. from the system, which the cluster machines already have.
#
# Usage:  graphviz-bootstrap [VERSION]
#   VERSION must match a graphviz package version in the apt index
#   (default targets Ubuntu 22.04 jammy).
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App tree     → $SGO/graphviz/<version>/          persistent on sgoinfre
# Cached .debs → $SGO/.cache/graphviz-<version>/
# Wrappers     → ~/bin/dot, ~/bin/neato, …         (not symlinks: need env)
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
# shellcheck source=../lib/bootstrap.bash
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-2.42.2-6}"
APP_HOME="$SGO/graphviz/${VERSION}"
DEB_CACHE="$CACHE/graphviz-${VERSION}"
LIB_SUBDIR="usr/lib/x86_64-linux-gnu"

# graphviz plus the libraries it links against on jammy. Its layout/render
# plugins dlopen cairo/pango/libpng/freetype/fontconfig from the system.
LIB_PACKAGES=(libgvc6 libcgraph6 libcdt5 libpathplan4 libxdot4 libgts-0.7-5 libltdl7)

if needs_install "$APP_HOME" "$VERSION" usr/bin/dot; then
    if ! compgen -G "$DEB_CACHE/graphviz_*.deb" >/dev/null; then
        apt_download "$DEB_CACHE" "graphviz=$VERSION" "${LIB_PACKAGES[@]}"
    fi
    install_begin "$APP_HOME" "$VERSION"
    for deb in "$DEB_CACHE"/*.deb; do
        dpkg-deb -x "$deb" "$APP_HOME.tmp"
    done
    # config6a, graphviz's plugin registry, is generated by `dot -c` after a
    # normal apt install, not shipped in the .deb. It holds no absolute
    # paths, so it can be generated before the tree moves into place.
    LD_LIBRARY_PATH="$APP_HOME.tmp/$LIB_SUBDIR" GVBINDIR="$APP_HOME.tmp/$LIB_SUBDIR/graphviz" \
        "$APP_HOME.tmp/usr/bin/dot" -c
    install_commit "$APP_HOME" "$VERSION"
fi

LIB_DIR="$APP_HOME/$LIB_SUBDIR"
for src in "$APP_HOME/usr/bin/"*; do
    [[ -f "$src" && -x "$src" ]] || continue
    write_launcher "$(basename "$src")" <<WRAP
#!/usr/bin/env bash
export LD_LIBRARY_PATH="$LIB_DIR\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export GVBINDIR="$LIB_DIR/graphviz"
exec "$src" "\$@"
WRAP
done
