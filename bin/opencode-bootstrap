#!/usr/bin/env bash
# opencode-bootstrap — install/heal OpenCode through mise.
#
# Why mise: OpenCode v2 ships as the npm package @opencode/cli (a native binary
# pulled in via per-platform optional deps), installed with mise's npm backend.
# v1 lived at github:anomalyco/opencode; that entry is dropped on migration.
#
# mise installs npm packages with lifecycle scripts disabled, which leaves a
# stub `opencode` that only prints an error. The per-tool postinstall hook runs
# the package's own postinstall.mjs (hard-links the matching platform binary
# into place), then drops the other ~11 platform packages (~700 MB) from
# /sgoinfre. The hook lives in config.toml, so mise-bootstrap restores work too.
#
# Keeping it in the global mise config means mise-bootstrap can restore it after
# a sgoinfre wipe, while this script is the explicit opt-in entry point for the
# installer TUI.
#
# Usage:  opencode-bootstrap [VERSION]
#   default: track latest via npm:@opencode/cli
#   pinned:  write npm:@opencode/cli@VERSION to global mise config

set -euo pipefail

VERSION="${1:-}"
TOOL="npm:@opencode/cli"
LEGACY_TOOL="github:anomalyco/opencode"
PKG='$MISE_TOOL_INSTALL_PATH/node_modules'
HOOK="node $PKG/@opencode/cli/postinstall.mjs && rm -rf $PKG/.mise/@opencode+cli-*"
SPEC="${TOOL}[postinstall=${HOOK}]"
[[ -n "$VERSION" ]] && SPEC="${SPEC}@${VERSION}"

export MISE_DATA_DIR="/sgoinfre/goinfre/Perso/${USER}/mise-data"
export MISE_CACHE_DIR="/goinfre/${USER}/mise-cache"
mkdir -p "$MISE_DATA_DIR" "$MISE_CACHE_DIR"

if ! command -v mise >/dev/null 2>&1; then
    echo "[opencode-bootstrap] mise not on PATH — install mise first" >&2
    exit 1
fi

if grep -qF "\"$LEGACY_TOOL\"" "$HOME/.config/mise/config.toml" 2>/dev/null; then
    echo "[opencode-bootstrap] removing v1 entry from global mise config: $LEGACY_TOOL"
    mise use -g --remove "$LEGACY_TOOL"
    rm -rf "$MISE_DATA_DIR/installs/github-anomalyco-opencode"
fi

echo "[opencode-bootstrap] enabling OpenCode in global mise config: $TOOL${VERSION:+@$VERSION}"
mise use -g -y "$SPEC"

eval "$(mise env -s bash)"

# An install made before the hook existed still has the stub binary; mise sees
# it as installed and skips the hook, so force a reinstall to heal it.
if command -v opencode >/dev/null 2>&1 && ! opencode --version >/dev/null 2>&1; then
    echo "[opencode-bootstrap] opencode binary is a stub — reinstalling to run the postinstall hook"
    mise install -f "$TOOL${VERSION:+@$VERSION}"
fi

if ! command -v opencode >/dev/null 2>&1; then
    echo "[opencode-bootstrap] installed, but mise shims are not on PATH yet — open a new shell." >&2
    exit 0
fi
echo "[opencode-bootstrap] opencode ready: $(command -v opencode)"

# Tailnet providers (e.g. gx10) are only reachable through tailscaled's
# userspace proxy, and OpenCode can't use SOCKS — point its background service
# at the HTTP proxy from tailscale-bootstrap. Only when Tailscale is installed:
# with no daemon on :1056, every API call (cloud ones too) would fail.
if [[ -x "$HOME/bin/tailscale-serve" ]]; then
    proxy="http://127.0.0.1:1056"
    current="$(opencode service get env 2>/dev/null || true)"
    changed=0
    for kv in "HTTP_PROXY=$proxy" "HTTPS_PROXY=$proxy" "NO_PROXY=localhost,127.0.0.1,::1"; do
        name="${kv%%=*}" value="${kv#*=}"
        grep -qF "\"$name\": \"$value\"" <<<"$current" && continue
        opencode service set env "$name" "$value" >/dev/null
        changed=1
    done
    if (( changed )); then
        echo "[opencode-bootstrap] background service routed through Tailscale HTTP proxy ($proxy)"
        if pgrep -u "$USER" -f 'opencode.* serve --service' >/dev/null; then
            opencode service restart >/dev/null \
                && echo "[opencode-bootstrap] restarted background service — restart any open OpenCode TUI too"
        fi
    fi
fi
