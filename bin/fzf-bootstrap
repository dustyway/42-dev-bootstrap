#!/usr/bin/env bash
# fzf-bootstrap — install fzf (junegunn/fzf) from upstream prebuilt releases,
# sha256-verified against the release's checksums file.
#
# Usage:  fzf-bootstrap [VERSION]
#
# ─── Placement ────────────────────────────────────────────────────────────────
# App binary     → $SGO/fzf/<version>/fzf       persistent on sgoinfre
# Cached tarball → $SGO/.cache/fzf-<v>…tar.gz   ~1.5 MB, re-extract on wipe
# Launcher       → ~/bin/fzf                    symlink, under quota

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-0.65.2}"
ASSET="fzf-${VERSION}-linux_amd64.tar.gz"
SUMS="fzf_${VERSION}_checksums.txt"
BASE_URL="https://github.com/junegunn/fzf/releases/download/v${VERSION}"
APP_HOME="$SGO/fzf/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" fzf; then
    fetch "$BASE_URL/$ASSET" "$CACHE/$ASSET"
    fetch "$BASE_URL/$SUMS" "$CACHE/$SUMS"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$SUMS"
    # The tarball holds a bare `fzf` binary, no top-level directory.
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" fzf
fi

link_launcher "$APP_HOME/fzf"
