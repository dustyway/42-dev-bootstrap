#!/usr/bin/env bash
# 42-dev-validate — cheap static checks for this repo.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fail=0

ok() { printf '[ok] %s\n' "$*"; }
bad() { printf '[fail] %s\n' "$*" >&2; fail=1; }

check_bash_syntax() {
    if bash -n "$ROOT/install.sh" "$ROOT"/lib/*.bash "$ROOT"/bin/*; then
        ok "bash syntax"
    else
        bad "bash syntax"
    fi
}

check_install_sources_exist() {
    local path missing=0
    while IFS= read -r path; do
        [[ -e "$ROOT/$path" ]] || { bad "install.sh references missing $path"; missing=1; }
    done < <(sed -n 's/.*"\$REPO_ROOT\/\([^"]*\)".*/\1/p' "$ROOT/install.sh")
    (( missing == 0 )) && ok "install.sh source paths exist"
}

check_registry() {
    # shellcheck source=../lib/components.bash
    source "$ROOT/lib/components.bash"

    local row name cmd exe seen_names=" " missing=0
    for row in "${COMPONENTS[@]}"; do
        name=${row%%|*}
        parse_component_row "$name" || { bad "registry row does not parse: $name"; missing=1; continue; }

        if [[ "$seen_names" == *" $C_NAME "* ]]; then
            bad "duplicate component name: $C_NAME"
            missing=1
        fi
        seen_names+=" $C_NAME "

        cmd=$C_CMD
        exe=${cmd%% *}
        [[ -x "$ROOT/bin/$exe" ]] || { bad "component $C_NAME references missing bin/$exe"; missing=1; }
    done

    parse_component_row jetbrains/pycharm-pro && [[ "$C_PATH" == "jetbrains/pycharm-pro" ]] \
        || { bad "PyCharm Pro registry slug drift"; missing=1; }
    parse_component_row jetbrains/pycharm-ce && [[ "$C_PATH" == "jetbrains/pycharm-ce" ]] \
        || { bad "PyCharm Community registry slug drift"; missing=1; }
    parse_component_row aider && [[ "$C_PATH" == "uv-tools/aider-chat" ]] \
        || { bad "aider registry path drift"; missing=1; }
    parse_component_row opencode && [[ "$C_CMD" == "opencode-bootstrap" ]] \
        || { bad "opencode registry command drift"; missing=1; }

    if grep -rEq --exclude-dir=.git --exclude='42-dev-validate' \
        'pycharm-professional|pycharm-community|bin/(cleanup|setup)' "$ROOT"; then
        bad "stale renamed component reference found"
        missing=1
    fi

    (( missing == 0 )) && ok "component registry"
}

# Scripts that find /sgoinfre themselves can't be pointed at a scratch
# directory with BOOTSTRAP_SGO, so testing them touches real installs. Fail on
# a converted bootstrap that still has its own lookup; list the rest as todo.
check_bootstrap_lib() {
    local f name converted=0 total=0 todo=() stale=0
    for f in "$ROOT"/bin/*; do
        name=$(basename "$f")
        [[ "$name" == 42-dev-validate ]] && continue
        local uses_lib=0 own_lookup=0
        grep -Eq '^[[:space:]]*source .*lib/bootstrap\.bash' "$f" && uses_lib=1
        # Any code line (not a comment) naming the sgoinfre root.
        # (Not grep -q: with pipefail, an early exit can fail the pipeline.)
        grep -v '^[[:space:]]*#' "$f" | grep '/sgoinfre/goinfre/Perso' >/dev/null && own_lookup=1
        if [[ "$name" == *-bootstrap ]]; then
            total=$((total + 1))
            (( uses_lib )) && converted=$((converted + 1))
        fi
        if (( uses_lib && own_lookup )); then
            bad "$name sources lib/bootstrap.bash but still looks up /sgoinfre itself"
            stale=1
        elif (( own_lookup )) && ! grep -q 'BOOTSTRAP_SGO' "$f"; then
            todo+=("$name")
        fi
    done
    (( stale == 0 )) && ok "lib/bootstrap.bash: $converted of $total bootstraps"
    if (( ${#todo[@]} )); then
        printf '[todo] ignore BOOTSTRAP_SGO (not on lib/bootstrap.bash): %s\n' "${todo[*]}"
    fi
}

check_bash_syntax
check_install_sources_exist
check_registry
check_bootstrap_lib

exit "$fail"
