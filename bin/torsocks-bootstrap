#!/usr/bin/env bash
# torsocks-bootstrap — install torsocks without sudo, pointed at Tor Browser.
# Safe to run every login (idempotent).
#
# torsocks runs any program with its network calls sent through Tor's SOCKS
# port (LD_PRELOAD of libtorsocks.so), e.g. `torsocks ssh user@xxx.onion`.
# Same approach as graphviz-bootstrap: `apt-get download` + `dpkg-deb -x`
# into a private prefix. The package's `torsocks` script has /usr hard-coded
# as its prefix, so the extracted copy is rewritten.
#
# There is no system tor on the cluster, so torsocks.conf is rewritten to
# TorPort 9150, the SOCKS port of Tor Browser (see tor-browser-bootstrap),
# which must be open while you use torsocks. For a tor on 9050 instead:
# TORSOCKS_TOR_PORT=9050 torsocks …
#
# Usage:  torsocks-bootstrap [VERSION]
#   VERSION must match a torsocks package version in the apt index
#   (default targets Ubuntu 22.04 jammy).
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App tree     → $SGO/torsocks/<version>/   persistent on sgoinfre, <1 MB
# Cached .deb  → $SGO/.cache/torsocks_<version>_amd64.deb
# Wrapper      → ~/bin/torsocks             (sets TORSOCKS_CONF_FILE)
# Man page     → `man -l $SGO/torsocks/<version>/usr/share/man/man1/torsocks.1.gz`
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
# shellcheck source=../lib/bootstrap.bash
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-2.3.0-3}"
TOR_PORT=9150
APP_HOME="$SGO/torsocks/${VERSION}"
DEB="$CACHE/torsocks_${VERSION}_amd64.deb"

if needs_install "$APP_HOME" "$VERSION" usr/bin/torsocks; then
    [[ -s "$DEB" ]] || apt_download "$CACHE" "torsocks=${VERSION}"
    install_begin "$APP_HOME" "$VERSION"
    dpkg-deb -x "$DEB" "$APP_HOME.tmp"
    install_commit "$APP_HOME" "$VERSION"
fi

# Rewritten every run so an sgoinfre path change heals.
# 1. The script looks for libtorsocks.so under $prefix/lib/…
sed -i "s#^prefix=.*#prefix=$APP_HOME/usr#" "$APP_HOME/usr/bin/torsocks"
# 2. Tor Browser's SOCKS port instead of the system tor's 9050.
sed -i "s#^TorPort .*#TorPort $TOR_PORT#" "$APP_HOME/etc/tor/torsocks.conf"

# 3. Wrapper: the script would read /etc/tor/torsocks.conf otherwise.
write_launcher torsocks <<WRAP
#!/usr/bin/env bash
export TORSOCKS_CONF_FILE="\${TORSOCKS_CONF_FILE:-$APP_HOME/etc/tor/torsocks.conf}"
exec "$APP_HOME/usr/bin/torsocks" "\$@"
WRAP
