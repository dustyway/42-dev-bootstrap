#!/usr/bin/env bash
# clangd-bootstrap — install/heal a modern clangd on 42 cluster machines via
# the community clangd/clangd prebuilt releases. Safe to run every login
# (idempotent).
#
# Ubuntu 22.04's apt pins clangd to clang-14, too old for recent
# .clang-format keys (e.g. InsertNewlineAtEOF) and several LSP features
# eglot uses. ~/bin/clangd is a wrapper that adds --query-driver for
# mise-installed compilers (see the end of this script); it shadows the apt
# /bin/clangd since ~/bin comes first on PATH.
#
# Upstream publishes no checksums file, so the zip is verified against the
# sha256 digest GitHub records for each release asset.
#
# clang-format is not included: the zip ships clangd and its resource
# headers only. clangd has libFormat built in, so editor formatting through
# the LSP picks up ~/.clang-format. For the CLI, use conda:clang-format via
# mise.
#
# Usage:  clangd-bootstrap [VERSION]
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary     → $SGO/clangd/<version>/           persistent on sgoinfre
# Cached zip     → $SGO/.cache/clangd-linux-<v>…    ~110 MB, re-extract
# Launcher       → ~/bin/clangd                     wrapper script, tiny
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
# shellcheck source=../lib/bootstrap.bash
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-23.1.0}"
ASSET="clangd-linux-${VERSION}.zip"
URL="https://github.com/clangd/clangd/releases/download/${VERSION}/${ASSET}"
APP_HOME="$SGO/clangd/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/clangd; then
    # Drop other versions and their zips: sgoinfre's quota is tight.
    mkdir -p "$SGO/clangd"
    find "$SGO/clangd" -mindepth 1 -maxdepth 1 ! -name "$VERSION" -exec rm -rf {} +
    find "$CACHE" -maxdepth 1 -name 'clangd-linux-*' ! -name "$ASSET" ! -name "$ASSET.sha256" -delete

    fetch "$URL" "$CACHE/$ASSET"
    fetch_github_digest clangd/clangd "$VERSION" "$ASSET" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"

    install_begin "$APP_HOME" "$VERSION"
    # The zip has a single top-level clangd_<VERSION>/; move its contents up
    # so bin/ and lib/ sit at the root. clangd finds its resource headers
    # relative to the real binary, which the wrapper execs directly.
    unzip -q "$CACHE/$ASSET" -d "$APP_HOME.tmp"
    topdir="$APP_HOME.tmp/clangd_${VERSION}"
    [[ -d "$topdir" ]] || die "unexpected zip layout: no clangd_${VERSION}/"
    mv "$topdir"/* "$APP_HOME.tmp/"
    rmdir "$topdir"
    install_commit "$APP_HOME" "$VERSION"
fi

# Wrapper instead of a symlink, to pass --query-driver. Compilers from mise
# (e.g. conda:gxx's g++ 16) live under MISE_DATA_DIR, and clangd only asks a
# compiler for its system include paths when --query-driver allows it.
# Otherwise clangd falls back to the system GCC 12 headers and reports
# C++23 headers such as <print> as missing.
MISE_DATA="${MISE_DATA_DIR:-$SGO/mise-data}"
write_launcher clangd <<WRAPPER
#!/bin/sh
exec "$APP_HOME/bin/clangd" --query-driver="$MISE_DATA/**" "\$@"
WRAPPER
