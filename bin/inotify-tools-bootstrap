#!/usr/bin/env bash
# inotify-tools-bootstrap — install inotifywait/inotifywatch on 42 cluster
# machines. Phoenix's file_system dependency uses them for live reload in
# development. Safe to run every login (idempotent).
#
# Pulls a static build made by .github/workflows/build-inotify-tools.yml and
# published as a release of this repo, with a sha256 file next to it. mise
# has no inotify-tools plugin, apt needs root, and upstream publishes no
# prebuilt binaries.
#
# Usage:  inotify-tools-bootstrap [VERSION]
# Env override:  INOTIFY_TOOLS_BOOTSTRAP_REPO=owner/repo
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binaries   → $SGO/inotify-tools/<version>/     persistent on sgoinfre
# Cached tarball → $SGO/.cache/inotify-tools-<v>…    small (<1 MB)
# Launchers      → ~/bin/inotifywait, ~/bin/inotifywatch   symlinks, tiny
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-4.25.9.0}"
REPO="${INOTIFY_TOOLS_BOOTSTRAP_REPO:-dustyway/42-dev-bootstrap}"
ASSET="inotify-tools-${VERSION}-linux-x86_64.tar.gz"
URL="https://github.com/${REPO}/releases/download/inotify-tools-${VERSION}/${ASSET}"
APP_HOME="$SGO/inotify-tools/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/inotifywait; then
    fetch "$URL" "$CACHE/$ASSET"
    fetch "$URL.sha256" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" --strip-components=1
fi

link_launchers "$APP_HOME/bin"
