#!/usr/bin/env bash
# gcc-bootstrap — install/heal a modern GCC (C + C++) on 42 cluster machines.
# Safe to run every login (idempotent).
#
# Pulls a tarball built by .github/workflows/build-gcc.yml and published as a
# GitHub release asset on this repo. The cluster tops out at g++-12, whose
# libstdc++ lacks most of C++23 (<print>, std::ranges::to, ...).
#
# Programs built with this GCC need its libstdc++, but the loader would find
# the older system one first. So on install we drop a `specs` file into GCC's
# lib dir that adds `-rpath $APP_HOME/lib64` to every non-static link. Built
# binaries then run without LD_LIBRARY_PATH (as long as sgoinfre is intact).
#
# Launchers are versioned only (g++-16, gcc-16, ...), never plain gcc/g++/cc:
# 42 projects are graded against the system compiler, and shadowing it in
# ~/bin would silently change that. Point CMake at it explicitly:
#   cmake -DCMAKE_CXX_COMPILER=g++-16 ...
#
# Usage:  gcc-bootstrap [VERSION]
# Env override:  GCC_BOOTSTRAP_REPO=owner/repo (defaults to dustyway/42-dev-bootstrap)
#
# ─── Placement (same reasoning as emacs-/ocaml-bootstrap) ────────────────────
# Toolchain       → $SGO/gcc/<version>/           persistent on sgoinfre
# Cached tarball  → $SGO/.cache/gcc-<version>…    ~150 MB, re-extract on wipe
# Launchers       → ~/bin/<tool>-<major>          symlinks, tiny
# ──────────────────────────────────────────────────────────────────────────────

set -euo pipefail

VERSION="${1:-16.2.0}"
MAJOR="${VERSION%%.*}"
REPO="${GCC_BOOTSTRAP_REPO:-dustyway/42-dev-bootstrap}"
ASSET="gcc-${VERSION}-linux-x86_64.tar.xz"
URL="https://github.com/${REPO}/releases/download/gcc-${VERSION}/${ASSET}"

SGO="$(ls -d /sgoinfre/goinfre/Perso/*"${USER}"* 2>/dev/null | head -n1)"
[[ -z "$SGO" ]] && { echo "[gcc-bootstrap] sgoinfre path not found for $USER" >&2; exit 1; }

APP_HOME="$SGO/gcc/${VERSION}"
TARBALL="$SGO/.cache/${ASSET}"
SHAFILE="$SGO/.cache/${ASSET}.sha256"
VERSION_MARKER="$APP_HOME/.gcc-bootstrap-version"

mkdir -p "$(dirname "$TARBALL")" "$SGO/gcc"

installed=""
[[ -f "$VERSION_MARKER" ]] && installed=$(cat "$VERSION_MARKER")

if [[ ! -x "$APP_HOME/bin/g++" || "$installed" != "$VERSION" ]]; then
    if [[ ! -s "$TARBALL" ]]; then
        echo "[gcc-bootstrap] downloading $ASSET"
        curl -fL --retry 3 -o "$TARBALL" "$URL"
        curl -fsSL -o "$SHAFILE" "${URL}.sha256"
        (cd "$(dirname "$TARBALL")" && sha256sum -c "$(basename "$SHAFILE")") \
            || { echo "[gcc-bootstrap] sha256 mismatch for $ASSET" >&2; rm -f "$TARBALL"; exit 1; }
    fi
    echo "[gcc-bootstrap] installing GCC $VERSION to $APP_HOME"
    rm -rf "$APP_HOME.tmp" "$APP_HOME"
    mkdir -p "$APP_HOME.tmp"
    tar -xJf "$TARBALL" -C "$APP_HOME.tmp" --strip-components=1
    mv "$APP_HOME.tmp" "$APP_HOME"
    printf '%s' "$VERSION" > "$VERSION_MARKER"
fi

# Bake the rpath into the driver's specs. A `specs` file in the lib dir
# replaces the built-in specs wholesale, so start from -dumpspecs and append
# to *link:. Regenerate if missing or written for a different path.
SPECS="$(dirname "$("$APP_HOME/bin/gcc" -print-libgcc-file-name)")/specs"
RPATH_SPEC="%{!static:%{!static-pie:-rpath $APP_HOME/lib64}}"
if ! grep -qF -- "$RPATH_SPEC" "$SPECS" 2>/dev/null; then
    rm -f "$SPECS"
    "$APP_HOME/bin/gcc" -dumpspecs > "$SPECS.tmp"
    sed -i "/^\*link:\$/{n;s|\$| $RPATH_SPEC|}" "$SPECS.tmp"
    grep -qF -- "$RPATH_SPEC" "$SPECS.tmp" \
        || { echo "[gcc-bootstrap] could not patch *link: in specs" >&2; rm -f "$SPECS.tmp"; exit 1; }
    mv "$SPECS.tmp" "$SPECS"
fi

mkdir -p "$HOME/bin"
for tool in gcc g++ cpp gcc-ar gcc-nm gcc-ranlib gcov gcov-dump gcov-tool lto-dump; do
    [[ -x "$APP_HOME/bin/$tool" ]] && ln -sf "$APP_HOME/bin/$tool" "$HOME/bin/$tool-$MAJOR"
done

# Prove the whole chain: C++23 library features compile, and the binary finds
# the new libstdc++ with no LD_LIBRARY_PATH.
check="$(mktemp -d -t gcc-bootstrap.XXXXXX)"
trap 'rm -rf "$check"' EXIT
cat > "$check/t.cpp" <<'EOF'
#include <print>
#include <ranges>
#include <vector>
int main() {
    auto v = std::views::iota(1, 4) | std::ranges::to<std::vector>();
    std::println("{}", v.size());
}
EOF
"$APP_HOME/bin/g++" -std=c++23 "$check/t.cpp" -o "$check/t"
[[ "$(env -u LD_LIBRARY_PATH "$check/t")" == "3" ]] \
    || { echo "[gcc-bootstrap] smoke test failed" >&2; exit 1; }

echo "[gcc-bootstrap] $("$HOME/bin/g++-$MAJOR" --version | head -n1) ready at $APP_HOME"
