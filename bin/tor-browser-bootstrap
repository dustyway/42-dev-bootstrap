#!/usr/bin/env bash
# tor-browser-bootstrap — install/heal Tor Browser on 42 cluster machines from
# the official torproject.org tarball. Safe to run every login (idempotent).
#
# No apt, no sudo: Tor Browser is a self-contained tarball. While it runs it
# also gives you a Tor SOCKS5 proxy on 127.0.0.1:9150, so other tools can use
# Tor without a system tor, e.g.
#   ssh -o ProxyCommand="nc -X 5 -x 127.0.0.1:9150 %h %p" user@xxx.onion
#
# Version: the latest stable release from Tor's update feed (downloads.json),
# or VERSION if given. The tarball is sha256-verified against Tor's
# sha256sums-signed-build.txt. Downloads come from archive.torproject.org,
# which keeps every release (dist.torproject.org drops old ones).
#
# Tor Browser's built-in updater is disabled via a Firefox enterprise policy:
# this script is the updater, so the version marker always matches the files.
# The browser profile lives inside the install dir and is reset on a version
# switch — fine for Tor Browser, which is amnesic by design.
#
# Usage:  tor-browser-bootstrap [VERSION]
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App            → $SGO/tor-browser/<version>/                           ~400 MB
# Cached tarball → $SGO/.cache/tor-browser-linux-x86_64-<version>.tar.xz ~110 MB
# Launcher       → ~/bin/tor-browser                                     wrapper
# Desktop entry  → ~/.local/share/applications/tor-browser.desktop
# Old versions and their tarballs are removed after a successful switch.
# ──────────────────────────────────────────────────────────────────────────────

set -euo pipefail

FEED="https://aus1.torproject.org/torbrowser/update_3/release/downloads.json"
ARCHIVE="https://archive.torproject.org/tor-package-archive/torbrowser"

SGO="$(ls -d /sgoinfre/goinfre/Perso/*"${USER}"* 2>/dev/null | head -n1)"
[[ -z "$SGO" ]] && { echo "[tor-browser-bootstrap] sgoinfre path not found for $USER" >&2; exit 1; }

BASE="$SGO/tor-browser"
CURRENT_MARKER="$BASE/.current-version"
mkdir -p "$SGO/.cache" "$BASE"

# 1. Which version? Offline with something installed → keep what we have.
VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
    VERSION=$(curl -fsSL --max-time 20 "$FEED" \
        | python3 -I -c 'import json, sys; print(json.load(sys.stdin)["version"])') || VERSION=""
fi
if [[ -z "$VERSION" ]]; then
    [[ -s "$CURRENT_MARKER" ]] || { echo "[tor-browser-bootstrap] cannot resolve latest version" >&2; exit 1; }
    VERSION=$(cat "$CURRENT_MARKER")
    echo "[tor-browser-bootstrap] update feed unreachable, keeping $VERSION"
fi

ASSET="tor-browser-linux-x86_64-${VERSION}.tar.xz"
APP_HOME="$BASE/$VERSION"
TARBALL="$SGO/.cache/$ASSET"
SHAFILE="$TARBALL.sha256"
VERSION_MARKER="$APP_HOME/.tor-browser-bootstrap-version"

# 2. Download, verify, extract.
installed=""
[[ -f "$VERSION_MARKER" ]] && installed=$(cat "$VERSION_MARKER")

if [[ ! -x "$APP_HOME/Browser/start-tor-browser" || "$installed" != "$VERSION" ]]; then
    if [[ ! -s "$TARBALL" ]]; then
        echo "[tor-browser-bootstrap] downloading $ASSET"
        curl -fL --retry 3 -o "$TARBALL" "$ARCHIVE/$VERSION/$ASSET"
    fi
    curl -fsSL "$ARCHIVE/$VERSION/sha256sums-signed-build.txt" \
        | grep "  ${ASSET}\$" > "$SHAFILE" \
        || { echo "[tor-browser-bootstrap] no checksum for $ASSET" >&2; exit 1; }
    (cd "$(dirname "$TARBALL")" && sha256sum -c --quiet "$(basename "$SHAFILE")") \
        || { echo "[tor-browser-bootstrap] sha256 mismatch for $ASSET" >&2; rm -f "$TARBALL"; exit 1; }

    echo "[tor-browser-bootstrap] installing Tor Browser $VERSION to $APP_HOME"
    rm -rf "$APP_HOME.tmp" "$APP_HOME"
    mkdir -p "$APP_HOME.tmp"
    # Tarball top-level dir is tor-browser/; strip it.
    tar -xJf "$TARBALL" -C "$APP_HOME.tmp" --strip-components=1
    mv "$APP_HOME.tmp" "$APP_HOME"
    printf '%s' "$VERSION" > "$VERSION_MARKER"
fi

# 3. Disable the built-in updater (rewritten every run, it's tiny).
mkdir -p "$APP_HOME/Browser/distribution"
printf '{ "policies": { "DisableAppUpdate": true } }\n' \
    > "$APP_HOME/Browser/distribution/policies.json"

# 4. Remember the current version, drop older installs and tarballs.
printf '%s' "$VERSION" > "$CURRENT_MARKER"
for old in "$BASE"/*/; do
    old=${old%/}
    [[ "$(basename "$old")" == "$VERSION" ]] && continue
    echo "[tor-browser-bootstrap] removing old $old"
    rm -rf "$old"
done
for old in "$SGO"/.cache/tor-browser-linux-x86_64-*.tar.xz*; do
    [[ -e "$old" && "$old" != "$TARBALL" && "$old" != "$SHAFILE" ]] && rm -f "$old"
done

# 5. Launcher. A wrapper, not a symlink: start-tor-browser finds its install
#    dir from its own path. --detach returns the terminal right away.
mkdir -p "$HOME/bin"
rm -f "$HOME/bin/tor-browser"
cat > "$HOME/bin/tor-browser" <<WRAP
#!/usr/bin/env bash
exec "$APP_HOME/Browser/start-tor-browser" --detach "\$@"
WRAP
chmod 0755 "$HOME/bin/tor-browser"

# 6. Desktop entry, same approach as ghidra-bootstrap (absolute paths,
#    rewritten each run so a version switch heals).
desktop_dir="$HOME/.local/share/applications"
mkdir -p "$desktop_dir"
cat > "$desktop_dir/tor-browser.desktop" <<DESK
[Desktop Entry]
Name=Tor Browser
GenericName=Web Browser
Comment=Browse the web anonymously through Tor
Exec=$HOME/bin/tor-browser
Icon=$APP_HOME/Browser/browser/chrome/icons/default/default128.png
Type=Application
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=Tor Browser
DESK
command -v update-desktop-database >/dev/null 2>&1 \
  && update-desktop-database "$desktop_dir" >/dev/null 2>&1 || true
