#!/usr/bin/env bash
# postgres-bootstrap — install/heal a PostgreSQL server on 42 cluster machines
# via theseus-rs's prebuilt binaries. Safe to run every login (idempotent).
#
# Postgres's source build needs bison and flex, which can't be installed
# without root here, and mise's postgres plugins compile from source.
# theseus-rs (https://github.com/theseus-rs/postgresql-binaries) publishes
# prebuilt tarballs with a sha256 file each, which is required and checked.
# A third-party build is fine for a local dev database behind localhost, not
# for production data.
#
# Usage:  postgres-bootstrap [VERSION]
#   VERSION accepts upstream 2-part (18.3) or theseus-rs 3-part (18.3.0).
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary       → $SGO/postgres/<version>/          persistent on sgoinfre
# Cached tarball   → $SGO/.cache/postgresql-<v>…       ~11 MB, re-extract
# Launchers        → ~/bin/<pg tool>                   symlinks, tiny
# Data directory   → NOT managed here. PGDATA is per project; run
#                    `initdb -D /sgoinfre/.../<app>-pgdata` in your app repo.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

raw_version="${1:-18.3}"
# theseus-rs tags with a trailing .0 that upstream Postgres doesn't use.
if [[ "$raw_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
    VERSION="${raw_version}.0"
elif [[ "$raw_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    VERSION="$raw_version"
else
    die "invalid version: $raw_version"
fi

ASSET="postgresql-${VERSION}-x86_64-unknown-linux-gnu.tar.gz"
URL="https://github.com/theseus-rs/postgresql-binaries/releases/download/${VERSION}/${ASSET}"
APP_HOME="$SGO/postgres/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/postgres; then
    fetch "$URL" "$CACHE/$ASSET"
    fetch "$URL.sha256" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" --strip-components=1
fi

# Postgres binaries are relocatable (they find share/ and lib/ relative to
# themselves), so plain symlinks work.
link_launchers "$APP_HOME/bin"
