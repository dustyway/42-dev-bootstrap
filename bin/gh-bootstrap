#!/usr/bin/env bash
# gh-bootstrap — install/heal the GitHub CLI on 42 cluster machines via the
# upstream cli/cli prebuilt releases, sha256-verified against the release's
# checksums file. Safe to run every login (idempotent).
#
# ~/bin/gh is a symlink, and ~/bin comes first on PATH, so it shadows any
# older apt /usr/bin/gh. apt's gh lags upstream, and apt needs sudo, which 42
# cluster users don't have. Upstream's tarball needs nothing but glibc.
#
# Auth survives wipes: `gh auth login` writes ~/.config/gh/ in $HOME.
#
# Usage:  gh-bootstrap [VERSION]
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary     → $SGO/gh/<version>/                       persistent on sgoinfre
# Cached tarball → $SGO/.cache/gh_<v>_linux_amd64.tar.gz   ~14 MB, re-extract
# Launcher       → ~/bin/gh                                 symlink, tiny
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-2.91.0}"
ASSET="gh_${VERSION}_linux_amd64.tar.gz"
SUMS="gh_${VERSION}_checksums.txt"
BASE_URL="https://github.com/cli/cli/releases/download/v${VERSION}"
APP_HOME="$SGO/gh/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" bin/gh; then
    fetch "$BASE_URL/$ASSET" "$CACHE/$ASSET"
    fetch "$BASE_URL/$SUMS" "$CACHE/$SUMS"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$SUMS"
    # Top-level gh_<v>_linux_amd64/ stripped, so bin/ and share/ sit at the root.
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" --strip-components=1
fi

link_launcher "$APP_HOME/bin/gh"
