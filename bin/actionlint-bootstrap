#!/usr/bin/env bash
# actionlint-bootstrap — install/heal actionlint on 42 cluster machines via
# the upstream rhysd/actionlint prebuilt releases. Safe to run every login
# (idempotent).
#
# actionlint is not in apt; the prebuilt binary is a single static Go binary
# that needs nothing but the kernel. sha256-verified against the release's
# checksums file.
#
# Usage:  actionlint-bootstrap [VERSION]
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary     → $SGO/actionlint/<version>/actionlint   persistent on sgoinfre
# Cached tarball → $SGO/.cache/actionlint_<v>_linux_amd64.tar.gz
# Launcher       → ~/bin/actionlint                       symlink, tiny
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-1.7.7}"
ASSET="actionlint_${VERSION}_linux_amd64.tar.gz"
SUMS="actionlint_${VERSION}_checksums.txt"
BASE_URL="https://github.com/rhysd/actionlint/releases/download/v${VERSION}"
APP_HOME="$SGO/actionlint/${VERSION}"

if needs_install "$APP_HOME" "$VERSION" actionlint; then
    fetch "$BASE_URL/$ASSET" "$CACHE/$ASSET"
    fetch "$BASE_URL/$SUMS" "$CACHE/$SUMS"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$SUMS"
    # Binary at the top level, no subdirectory.
    install_tarball "$CACHE/$ASSET" "$APP_HOME" "$VERSION" actionlint
fi

link_launcher "$APP_HOME/actionlint"
