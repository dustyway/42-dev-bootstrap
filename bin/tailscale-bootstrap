#!/usr/bin/env bash
# tailscale-bootstrap — install/heal the Tailscale VPN client on 42 cluster
# machines without root, and start its daemon. Safe to run every login
# (idempotent).
#
# Uses Tailscale's userspace-networking mode (no kernel TUN, no sudo).
# Traffic reaches the tailnet through a SOCKS5 proxy at 127.0.0.1:1055 or an
# HTTP proxy at 127.0.0.1:1056. The HTTP proxy is needed by clients such as
# OpenCode that do not support SOCKS proxy URLs.
# The ~/bin/tailscale wrapper injects --socket so plain `tailscale up` works.
# Auth state lives in ~/.config/tailscale/ ($HOME) — survives /sgoinfre wipes.
#
# Usage:  tailscale-bootstrap [VERSION]
#         TAILSCALE_NO_START=1 tailscale-bootstrap   install only, don't
#                                                    start the daemon
# Then:   tailscale up  (first time only, to authenticate)
#         ALL_PROXY=socks5://127.0.0.1:1055 curl https://my-host.ts.net/
#         HTTP_PROXY=http://127.0.0.1:1056 curl http://my-host.ts.net/
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binaries   → $SGO/tailscale/<version>/bin/   persistent on sgoinfre
# Cached tarball → $SGO/.cache/tailscale_<v>_amd64.tgz (+ .sha256)
# State          → ~/.config/tailscale/            HOME, survives wipes
# Socket         → /tmp/tailscale-$USER.sock       ephemeral
# tailscale      → ~/bin/tailscale                 wrapper (injects --socket)
# tailscaled     → ~/bin/tailscaled                symlink
# Launcher       → ~/bin/tailscale-serve           written each run
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-1.82.0}"
ASSET="tailscale_${VERSION}_amd64.tgz"
URL="https://pkgs.tailscale.com/stable/${ASSET}"
APP_HOME="$SGO/tailscale/${VERSION}"
STATE_DIR="$HOME/.config/tailscale"
SOCKET="/tmp/tailscale-${USER}.sock"
HTTP_PROXY_ADDR="127.0.0.1:1056"

mkdir -p "$STATE_DIR"

if needs_install "$APP_HOME" "$VERSION" bin/tailscaled; then
    fetch "$URL" "$CACHE/$ASSET"
    # The .sha256 file holds just the hash.
    fetch "$URL.sha256" "$CACHE/$ASSET.sha256"
    verify_sha256 "$CACHE/$ASSET" "$CACHE/$ASSET.sha256"
    install_begin "$APP_HOME" "$VERSION"
    mkdir -p "$APP_HOME.tmp/bin"
    tar -xzf "$CACHE/$ASSET" -C "$APP_HOME.tmp/bin" --strip-components=1 \
        "tailscale_${VERSION}_amd64/tailscale" \
        "tailscale_${VERSION}_amd64/tailscaled"
    install_commit "$APP_HOME" "$VERSION"
fi

# Wrapper injects --socket so `tailscale up` / `tailscale status` work as-is.
write_launcher tailscale <<EOS
#!/usr/bin/env bash
exec "$APP_HOME/bin/tailscale" --socket="${SOCKET}" "\$@"
EOS

link_launcher "$APP_HOME/bin/tailscaled"

# Daemon launcher: no-op if the daemon is already running with both proxies.
write_launcher tailscale-serve <<EOS
#!/usr/bin/env bash
set -euo pipefail
LOG="/tmp/tailscale-\${USER}.log"
proxy_ready() {
    (exec 3<>/dev/tcp/${HTTP_PROXY_ADDR/://}) 2>/dev/null
}
if "$HOME/bin/tailscale" status >/dev/null 2>&1 && proxy_ready; then
    echo "[tailscale-serve] already running"
    exit 0
fi
if "$HOME/bin/tailscale" status >/dev/null 2>&1; then
    # Upgrade an older daemon started without the HTTP proxy. The cluster's
    # system daemon is root-owned, so this targets only the user's daemon.
    pkill -u "\$USER" -x tailscaled || true
    for _ in \$(seq 1 20); do
        "$HOME/bin/tailscale" status >/dev/null 2>&1 || break
        sleep 0.1
    done
fi
setsid "$HOME/bin/tailscaled" \\
    --tun=userspace-networking \\
    --socket="${SOCKET}" \\
    --state="${STATE_DIR}/tailscaled.state" \\
    --socks5-server=127.0.0.1:1055 \\
    --outbound-http-proxy-listen="${HTTP_PROXY_ADDR}" \\
    >>"\$LOG" 2>&1 &
disown
for _ in \$(seq 1 20); do
    "$HOME/bin/tailscale" status >/dev/null 2>&1 && break
    sleep 0.5
done
echo "[tailscale-serve] started (SOCKS5: 127.0.0.1:1055, HTTP: ${HTTP_PROXY_ADDR}, log: \$LOG)"
echo "[tailscale-serve] first time? run: tailscale up"
EOS

[[ -n "${TAILSCALE_NO_START:-}" ]] || "$HOME/bin/tailscale-serve"
