#!/usr/bin/env bash
# act-bootstrap — install/heal act (the GitHub Actions local runner) on 42
# cluster machines via the upstream nektos/act prebuilt releases. Safe to
# run every login (idempotent).
#
# act is not in apt; the prebuilt binary is a single static Go binary that
# needs nothing but the kernel. sha256-verified against the release's
# checksums.txt.
#
# act runs workflow jobs in Docker containers, using the cluster's rootless
# Docker (see docker-bootstrap, which keeps its data-root on /goinfre).
#
# Usage:  act-bootstrap [VERSION]
#
# ─── Placement ───────────────────────────────────────────────────────────────
# App binary     → $SGO/act/<version>/act              persistent on sgoinfre
# Cached tarball → $SGO/.cache/act_<v>_act_Linux_x86_64.tar.gz
# Launcher       → ~/bin/act                           symlink, tiny
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.bash"

VERSION="${1:-0.2.88}"
ASSET="act_Linux_x86_64.tar.gz"
BASE_URL="https://github.com/nektos/act/releases/download/v${VERSION}"
APP_HOME="$SGO/act/${VERSION}"
# Upstream's asset names don't carry the version, so the cached copies do.
TARBALL="$CACHE/act_${VERSION}_${ASSET}"
SUMS="$CACHE/act_${VERSION}_checksums.txt"

if needs_install "$APP_HOME" "$VERSION" act; then
    fetch "$BASE_URL/$ASSET" "$TARBALL"
    fetch "$BASE_URL/checksums.txt" "$SUMS"
    verify_sha256 "$TARBALL" "$SUMS" "$ASSET"
    # act + LICENSE + README at the top level; take just the binary.
    install_tarball "$TARBALL" "$APP_HOME" "$VERSION" act
fi

link_launcher "$APP_HOME/act"
